# ---------------------------------------------------------------------------
# Razona · variables de entorno (copiar a .env.local y completar)
# En Vercel, la integración Supabase–Vercel define las de Supabase automáticamente.
# ---------------------------------------------------------------------------

# Supabase (público). Local: `supabase status` → API_URL y PUBLISHABLE_KEY (o ANON_KEY).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
# Se acepta cualquiera de las dos (la integración de Vercel define ambas):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (SOLO servidor; nunca con prefijo NEXT_PUBLIC). Se usa en scripts/seed-demo.ts.
# Se acepta SUPABASE_SECRET_KEY o SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio (para OAuth y el QR). Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Modo demo: muestra el botón "Entrar como Ana (demo)".
NEXT_PUBLIC_DEMO_MODE=true
# Credenciales de Ana (SOLO servidor; la contraseña nunca llega al cliente).
DEMO_USER_EMAIL=ana.demo@razona.app
DEMO_USER_PASSWORD=cambia-esta-contrasena-demo

# Login con Google (opcional). Requiere configurar el proveedor en Supabase.
NEXT_PUBLIC_ENABLE_GOOGLE=false

# Tutor con Google ADK + Gemini. Si está vacío se usa el tutor de respaldo (rúbrica del banco de casos).
GOOGLE_GENAI_API_KEY=
# Modelo de Gemini. gemini-2.5-flash ya no está disponible para claves nuevas (nov 2026).
GEMINI_MODEL=gemini-3.5-flash
# Modelo de imagen para ilustrar el widget interactivo cuando no hay una imagen verificada
# (banco de casos o Wikimedia Commons). Si falla, el widget se muestra sin imagen.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Nivel de razonamiento (MINIMAL | LOW | MEDIUM | HIGH). MINIMAL mantiene al tutor por debajo del límite de 6 s.
GEMINI_THINKING_LEVEL=MINIMAL
# Tiempo máximo (ms) antes de cambiar al tutor de respaldo.
TUTOR_TIMEOUT_MS=6000

# P2 · Analítica (opcional; si falta la clave, no se envía nada).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Agente de diagnóstico (servidor Python en agent/, SOLO servidor).
# URL del servidor FastAPI (`cd agent && uv run python -m razona_agent.server`).
AGENT_API_URL=http://127.0.0.1:8080
# Secreto compartido con el agente (el agente lo lee de su .env o de este .env.local).
# Genera uno con: openssl rand -hex 24
AGENT_API_TOKEN=
