# ---------------------------------------------------------------------------
# Razona · agente Python (Google ADK). Copia a agent/.env y completa.
# Lo que falte aquí se toma del .env.local del repo (Supabase, DEMO_USER_EMAIL y
# GOOGLE_GENAI_API_KEY), así que en local normalmente solo necesitas la clave.
# Precedencia: variables de la terminal > agent/.env > ../.env.local
# ---------------------------------------------------------------------------

# Gemini (Google AI Studio: https://aistudio.google.com/apikey). OBLIGATORIA para chatear.
GOOGLE_API_KEY=
# Alias aceptado (el mismo nombre que usa la app de Next.js). Si defines ambas, gana GOOGLE_API_KEY.
# GOOGLE_GENAI_API_KEY=
# FALSE = API de Gemini con clave. TRUE = Vertex AI (requiere GOOGLE_CLOUD_PROJECT y GOOGLE_CLOUD_LOCATION).
GOOGLE_GENAI_USE_VERTEXAI=FALSE
# Modelo (por defecto, el modelo por defecto de google-adk 2.15: gemini-3.5-flash).
GEMINI_MODEL=gemini-3.5-flash

# Supabase. Local: `supabase status` → API URL y la llave secreta (service role).
# La llave secreta salta RLS: es SOLO de servidor; el agente filtra por user_id en cada consulta.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_SECRET_KEY=
# Opcional (no lo usa el agente; útil para inspeccionar con psql).
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# Estudiante por defecto cuando la sesión no trae una (CLI/servidor sin --email, `adk web`).
DEMO_USER_EMAIL=ana.demo@razona.app
# TRUE (por defecto): en `adk web` (user id "user") se actúa como DEMO_USER_EMAIL.
# Ponlo en FALSE fuera de la demo local.
RAZONA_DEMO_FALLBACK=TRUE

# Secreto compartido con la app web (Authorization: Bearer). Si está definido, el servidor lo exige
# en todos los endpoints excepto /salud. En local se toma del .env.local del repo.
AGENT_API_TOKEN=
