{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://razona.mx/esquema/caso.schema.json",
  "title": "Caso clínico de Razona (reactivo tipo ENARM con rúbrica de errores)",
  "description": "Un caso índice o su variante de transferencia. Toda afirmación clínica en puntos_clave y rubrica cita la GPC mexicana. 'pagina' es el número de página del archivo PDF, contado desde 1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "version", "sindrome", "tipo", "caso_indice_id", "gpc_base", "vineta", "pregunta",
    "opciones", "respuesta_correcta", "puntos_clave", "rubrica", "autor", "estado", "fecha", "licencia"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^RZ-PED-[0-9]{3}-(I|V1)$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "sindrome": {"type": "string", "pattern": "^[a-z0-9_]+$", "description": "Tema clínico de la guía en snake_case (en este banco, uno por GPC)."},
    "tipo": {"enum": ["indice", "variante"]},
    "caso_indice_id": {"type": ["string", "null"]},
    "gpc_base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guia", "clave", "archivo"],
      "properties": {
        "guia": {"type": "string", "minLength": 10},
        "clave": {"type": "string", "pattern": "^(GPC-)?(IMSS|SSA)-[0-9]{3}-[0-9]{2}$"},
        "archivo": {"type": "string", "pattern": "^[0-9]{3}GER(_0)?\\.pdf$"}
      }
    },
    "vineta": {"type": "string", "minLength": 200, "maxLength": 1800},
    "pregunta": {"type": "string", "minLength": 15, "maxLength": 300},
    "opciones": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A", "B", "C", "D", "E"],
      "properties": {
        "A": {"$ref": "#/$defs/opcion"}, "B": {"$ref": "#/$defs/opcion"}, "C": {"$ref": "#/$defs/opcion"},
        "D": {"$ref": "#/$defs/opcion"}, "E": {"$ref": "#/$defs/opcion"}
      }
    },
    "respuesta_correcta": {"enum": ["A", "B", "C", "D", "E"]},
    "puntos_clave": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["texto", "cita_gpc"],
        "properties": {"texto": {"type": "string", "minLength": 20}, "cita_gpc": {"$ref": "#/$defs/cita"}}
      }
    },
    "rubrica": {
      "type": "array", "minItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["tipo_error", "descripcion", "opciones_asociadas", "senales_en_justificacion",
                     "pregunta_socratica_semilla", "explicacion", "cita_gpc"],
        "properties": {
          "tipo_error": {"enum": ["lectura", "dato_omitido", "razonamiento", "conocimiento"]},
          "descripcion": {"type": "string", "minLength": 20},
          "opciones_asociadas": {"type": "array", "items": {"enum": ["A", "B", "C", "D", "E"]}, "minItems": 1, "uniqueItems": true},
          "senales_en_justificacion": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 3}},
          "pregunta_socratica_semilla": {"type": "string", "minLength": 15, "pattern": "\\?$"},
          "explicacion": {"type": "string", "minLength": 40},
          "cita_gpc": {"$ref": "#/$defs/cita"}
        }
      }
    },
    "autor": {"const": "claude"},
    "estado": {"enum": ["borrador", "en_revision", "revisado_medico", "retirado"]},
    "fecha": {"type": "string", "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$"},
    "licencia": {"type": "string", "minLength": 10},
    "recursos": {
      "type": "array", "minItems": 1,
      "description": "Recursos de aprendizaje que se muestran después de responder y complementan la explicación del tutor.",
      "items": {"$ref": "#/$defs/recurso"}
    }
  },
  "allOf": [
    {"if": {"properties": {"tipo": {"const": "indice"}}},
     "then": {"properties": {"caso_indice_id": {"type": "null"}, "id": {"pattern": "-I$"},
       "recursos": {
         "allOf": [
           {"contains": {"properties": {"tipo": {"const": "flashcard"}}}, "minContains": 2, "maxContains": 3},
           {"contains": {"properties": {"tipo": {"const": "diagrama"}}}, "minContains": 1, "maxContains": 1},
           {"contains": {"properties": {"tipo": {"const": "resaltado"}}}, "minContains": 1, "maxContains": 3},
           {"contains": {"properties": {"tipo": {"const": "imagen"}}}, "minContains": 0, "maxContains": 2},
           {"contains": {"properties": {"tipo": {"const": "tabla"}}}, "minContains": 0, "maxContains": 1}
         ]}}}},
    {"if": {"properties": {"tipo": {"const": "variante"}}},
     "then": {"properties": {"caso_indice_id": {"type": "string", "pattern": "^RZ-PED-[0-9]{3}-I$"}, "id": {"pattern": "-V1$"},
       "recursos": {"maxItems": 3, "items": {"properties": {"tipo": {"const": "resaltado"}}}}}}}
  ],
  "$defs": {
    "opcion": {"type": "string", "minLength": 2, "maxLength": 250},
    "rec_id": {"type": "string", "pattern": "^RZ-PED-[0-9]{3}-(I|V1)-R[0-9]+$"},
    "rec_concepto": {"type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"},
    "rec_errores": {"type": "array", "minItems": 1, "uniqueItems": true,
                    "items": {"enum": ["lectura", "dato_omitido", "razonamiento", "conocimiento"]}},
    "rec_mostrar": {"const": "despues_de_responder"},
    "rec_estado": {"enum": ["borrador", "en_revision", "revisado_medico", "retirado"]},
    "recurso": {
      "oneOf": [
        {"type": "object", "additionalProperties": false,
         "required": ["id", "tipo", "concepto", "para_errores", "mostrar", "estado", "frente", "reverso", "cita"],
         "properties": {
           "id": {"$ref": "#/$defs/rec_id"}, "tipo": {"const": "flashcard"},
           "concepto": {"$ref": "#/$defs/rec_concepto"}, "para_errores": {"$ref": "#/$defs/rec_errores"},
           "mostrar": {"$ref": "#/$defs/rec_mostrar"}, "estado": {"$ref": "#/$defs/rec_estado"},
           "frente": {"type": "string", "minLength": 10, "maxLength": 250},
           "reverso": {"type": "string", "minLength": 5, "pattern": "^\\s*\\S+(\\s+\\S+){0,24}\\s*$",
                       "description": "Máximo 25 palabras."},
           "cita": {"$ref": "#/$defs/cita"}}},
        {"type": "object", "additionalProperties": false,
         "required": ["id", "tipo", "concepto", "para_errores", "mostrar", "estado", "codigo", "citas"],
         "properties": {
           "id": {"$ref": "#/$defs/rec_id"}, "tipo": {"const": "diagrama"},
           "concepto": {"$ref": "#/$defs/rec_concepto"}, "para_errores": {"$ref": "#/$defs/rec_errores"},
           "mostrar": {"$ref": "#/$defs/rec_mostrar"}, "estado": {"$ref": "#/$defs/rec_estado"},
           "codigo": {"type": "string", "minLength": 20, "maxLength": 3000,
                      "description": "Mermaid flowchart TD; máximo 12 nodos, texto de nodos entre comillas."},
           "citas": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/cita"}}}},
        {"type": "object", "additionalProperties": false,
         "required": ["id", "tipo", "concepto", "para_errores", "mostrar", "estado", "fragmento", "motivo"],
         "properties": {
           "id": {"$ref": "#/$defs/rec_id"}, "tipo": {"const": "resaltado"},
           "concepto": {"$ref": "#/$defs/rec_concepto"},
           "para_errores": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["lectura", "dato_omitido"]}},
           "mostrar": {"$ref": "#/$defs/rec_mostrar"}, "estado": {"$ref": "#/$defs/rec_estado"},
           "fragmento": {"type": "string", "minLength": 3, "maxLength": 300,
                         "description": "Texto literal de la viñeta del mismo caso."},
           "motivo": {"type": "string", "minLength": 20, "maxLength": 400}}},
        {"type": "object", "additionalProperties": false,
         "required": ["id", "tipo", "concepto", "para_errores", "mostrar", "estado", "columnas", "filas", "cita"],
         "properties": {
           "id": {"$ref": "#/$defs/rec_id"}, "tipo": {"const": "tabla"},
           "concepto": {"$ref": "#/$defs/rec_concepto"}, "para_errores": {"$ref": "#/$defs/rec_errores"},
           "mostrar": {"$ref": "#/$defs/rec_mostrar"}, "estado": {"$ref": "#/$defs/rec_estado"},
           "columnas": {"type": "array", "minItems": 2, "maxItems": 6, "items": {"type": "string", "minLength": 1}},
           "filas": {"type": "array", "minItems": 2, "maxItems": 10,
                     "items": {"type": "array", "minItems": 2, "maxItems": 6, "items": {"type": "string", "minLength": 1}}},
           "cita": {"$ref": "#/$defs/cita"}}},
        {"type": "object", "additionalProperties": false,
         "required": ["id", "tipo", "concepto", "para_errores", "mostrar", "estado", "url_imagen", "url_pagina",
                      "fuente", "autor", "licencia", "descripcion", "archivo", "sha256"],
         "properties": {
           "id": {"$ref": "#/$defs/rec_id"}, "tipo": {"const": "imagen"},
           "concepto": {"$ref": "#/$defs/rec_concepto"}, "para_errores": {"$ref": "#/$defs/rec_errores"},
           "mostrar": {"$ref": "#/$defs/rec_mostrar"}, "estado": {"$ref": "#/$defs/rec_estado"},
           "url_imagen": {"type": "string", "pattern": "^https://"},
           "url_pagina": {"type": "string", "pattern": "^https://"},
           "fuente": {"type": "string", "minLength": 3},
           "autor": {"type": "string", "minLength": 2},
           "licencia": {"type": "string", "minLength": 3},
           "descripcion": {"type": "string", "minLength": 20, "maxLength": 400},
           "archivo": {"type": "string", "pattern": "^assets/RZ-PED-[0-9]{3}-(I|V1)-R[0-9]+\\.(png|jpg|jpeg|gif|webp|svg)$"},
           "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
      ]
    },
    "cita": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["guia", "clave", "seccion", "pagina", "fragmento"],
          "properties": {
            "guia": {"type": "string", "minLength": 10},
            "clave": {"type": "string", "pattern": "^(GPC-)?(IMSS|SSA)-[0-9]{3}-[0-9]{2}$"},
            "seccion": {"type": "string", "minLength": 3},
            "pagina": {"type": "integer", "minimum": 1},
            "fragmento": {"type": "string", "minLength": 15, "maxLength": 220,
                          "description": "Texto literal breve de la página citada; permite verificar la cita de forma automática."}
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["estado", "motivo"],
          "properties": {"estado": {"const": "SIN_RESPALDO_GPC"}, "motivo": {"type": "string", "minLength": 10}}
        }
      ]
    }
  }
}
